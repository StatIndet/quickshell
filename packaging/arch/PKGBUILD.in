# shellcheck shell=bash disable=SC2034,SC2154
# Generated by scripts/release.py; dependencies come from packaging/dependencies.json.
pkgbase=clavis-shell
pkgname=('clavis-shell')
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Niri desktop shell built with Quickshell and Qt Quick'
arch=('x86_64')
url='https://github.com/StatIndet/quickshell'
license=('GPL-3.0-or-later' 'MIT' 'Apache-2.0' 'MPL-2.0' 'LGPL-3.0-only' 'OFL-1.1')
makedepends=@MAKEDEPENDS@
checkdepends=@CHECKDEPENDS@
source=("clavis-shell-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/clavis-shell-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
    cmake -S "clavis-shell-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCLAVIS_CONFIG_INSTALL_DIR=/etc/xdg/quickshell/clavis
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure --no-tests=error
    python "clavis-shell-${pkgver}/scripts/release.py" verify-resources
}

package_clavis-shell() {
    # Runtime backends do not participate in this repository's build or tests.
    depends=@CLAVIS_SHELL_DEPENDS@
    optdepends=@CLAVIS_SHELL_OPTDEPENDS@
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "clavis-shell-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/clavis-shell/LICENSE"
    cp -r "clavis-shell-${pkgver}/licenses" "${pkgdir}/usr/share/licenses/clavis-shell/third-party"
}
